{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "preferredNotifChannel": "terminal_bell",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_drawing_tests.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NonInteractive -NoProfile -Command \"[console]::beep(880,250); [console]::beep(1175,400)\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NonInteractive -NoProfile -Command \"[console]::beep(660,200); [console]::beep(660,200)\""
          }
        ]
      }
    ]
  }
}