{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "preferredNotifChannel": "terminal_bell",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_drawing_tests.py\""
